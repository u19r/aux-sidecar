{
  "name": "@auxfn/sidecar-cloudflare-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node ../../scripts/dpop-adapter-corpus.mjs --fixture ../../target/dpop-adapter-corpus.json && tsc --noEmit",
    "test": "node ../../scripts/dpop-adapter-corpus.mjs --fixture ../../target/dpop-adapter-corpus.json && vitest run",
    "dry-run": "wrangler deploy --dry-run --outdir ../../target/cloudflare-worker-dry-run --config wrangler.jsonc",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261024.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasm",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md",
    "wrangler.toml.example",
    "wrangler.jsonc"
  ],
  "license": "MIT OR Apache-2.0",
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.7"
  }
}
